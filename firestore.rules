rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function cost() { return exists(/databases/$(db)/documents/settings/site) ? get(/databases/$(db)/documents/settings/site).data.get('pointsPerAd', 5) : 5; }
    function str(v, max) { return v is string && v.size() <= max; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','role','phone','createdAt'])
        && request.resource.data.role in ['advertiser','artist']
        && str(request.resource.data.get('name',''), 100)
        && str(request.resource.data.get('email',''), 120)
        && str(request.resource.data.get('photo',''), 1000)
        && str(request.resource.data.get('phone',''), 30);
      allow delete: if isAdmin();
    }

    match /artists/{uid} {
      allow read: if (resource != null && resource.data.status == 'approved')
                  || (signedIn() && (request.auth.uid == uid || isAdmin()));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','photo','wa','platform','pageUrl','followers','bio','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid
        && str(request.resource.data.name, 100)
        && str(request.resource.data.photo, 1000)
        && str(request.resource.data.get('wa',''), 20)
        && str(request.resource.data.platform, 30)
        && str(request.resource.data.pageUrl, 300)
        && request.resource.data.pageUrl.matches('https?://.+')
        && request.resource.data.followers is number
        && request.resource.data.followers >= 0
        && str(request.resource.data.bio, 400)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pointPacks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /topups/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','name','packId','points','price','currency','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(db)/documents/artists/$(request.auth.uid))
        && str(request.resource.data.name, 100)
        && str(request.resource.data.packId, 60)
        && str(request.resource.data.currency, 20)
        && request.resource.data.points is number
        && request.resource.data.price is number
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
    match /ads/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin() || resource.data.artistUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','ownerName','ownerEmail','phone','service','packageId','packageTitle','brief','artistUid','artistName','status','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.ownerEmail == request.auth.token.email
        && str(request.resource.data.ownerName, 100)
        && str(request.resource.data.phone, 30)
        && str(request.resource.data.service, 60)
        && str(request.resource.data.packageId, 60)
        && str(request.resource.data.packageTitle, 100)
        && str(request.resource.data.brief, 1000)
        && str(request.resource.data.artistUid, 60)
        && str(request.resource.data.artistName, 100)
        && (request.resource.data.artistUid == '' || (
             get(/databases/$(db)/documents/artists/$(request.resource.data.artistUid)).data.status == 'approved'
          && get(/databases/$(db)/documents/artists/$(request.resource.data.artistUid)).data.get('points', 0) >= cost()))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
