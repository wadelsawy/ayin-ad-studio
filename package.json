{
  "name": "ayin-ad-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Ayin AD Studio Firestore security rules test harness",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ayn-marketplace \"node --test tests/firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2"
  }
}
